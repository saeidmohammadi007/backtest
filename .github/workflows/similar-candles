on:
  workflow_dispatch:
  schedule:
    - cron: "5 */4 * * *"   # هر ۴ ساعت، ۵ دقیقه بعد از بسته شدن کندل

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install ccxt pandas requests
      - run: python similar_candles.py
        env:
          SYMBOL: "ETH/USDT"
          HORIZON: "100"
          THRESHOLD: "0.006"
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
