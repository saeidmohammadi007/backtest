name: candle-finder

on:
  workflow_dispatch:
    inputs:
      symbols:
        description: "Symbols, comma separated"
        default: "BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,BNB/USDT,DOGE/USDT,ADA/USDT,LINK/USDT,AVAX/USDT,LTC/USDT"
      horizon:
        description: "Candles to look ahead"
        default: "100"
      k:
        description: "Number of candle-shape groups"
        default: "40"

jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install ccxt pandas numpy scikit-learn requests
      - name: Run
        env:
          SYMBOLS: ${{ inputs.symbols }}
          HORIZON: ${{ inputs.horizon }}
          K: ${{ inputs.k }}
        run: |
          python candle_finder.py | tee result.txt
          { echo '```'; cat result.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@v4
        with:
          name: result
          path: result.txt
